# ==========================================
# TokenWise Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Database Configuration
# In Docker or production: postgresql+asyncpg://tokenwise:tokenwise@postgres:5432/tokenwise
# For zero-dependency local dev: sqlite+aiosqlite:///./tokenwise.db
DATABASE_URL=sqlite+aiosqlite:///./tokenwise.db

# Redis Configuration (Optional in local dev, in-memory queue fallback is enabled)
# In Docker: redis://redis:6379/0
REDIS_URL=

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Upstream LLM Provider Defaults
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_SITE_URL=https://tokenwise.ai
OPENROUTER_SITE_NAME=TokenWise Observability

# Dynamic Catalog & Pricing Synchronization
TOKENWISE_PRICING_SYNC_ENABLED=true
TOKENWISE_PRICING_SYNC_INTERVAL_HOURS=24
TOKENWISE_MODEL_SYNC_INTERVAL_HOURS=24
TOKENWISE_PROMPT_CAPTURE_ENABLED=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
